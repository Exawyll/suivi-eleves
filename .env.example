# App
ENVIRONMENT=development
DEBUG=false

# Base de données. Railway injecte DATABASE_URL depuis le service Postgres ; le
# DSN synchrone qu'il fournit est réécrit vers asyncpg par app/config.py.
# En local, cette forme sans identifiants utilise l'utilisateur système et les
# variables PG* ; ajoutez-en seulement si votre Postgres l'exige.
DATABASE_URL=postgresql+asyncpg://localhost:5432/carnet

# Secret de signature des jetons — à générer, jamais à recopier :
#   openssl rand -hex 32
# Obligatoire dès ENVIRONMENT=production : l'application refuse de démarrer si
# la valeur est absente, trop courte, ou restée sur le placeholder de dev.
SECRET_KEY=

# Durées de vie des jetons
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Railway injecte automatiquement PORT au runtime
